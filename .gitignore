# Python 캐시 파일 (Git에서 제외)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg

# 가상환경 (Git에서 제외 - 용량이 크고 시스템 종속적임)
venv/
env/
.venv/

# 로컬 설정 및 환경 변수 (Git에서 제외 - 보안 및 로컬 전용)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
web/js/config.js
web/config.json

# IDE 설정 (Git에서 제외)
.idea/
.vscode/
*.swp
*.swo
.DS_Store
.thumbs.db

# 모델 파일 (.pt) 
# [중요] 배포 시 필요하므로 Git에 포함(Track)합니다. 
# 만약 제외하고 싶다면 아래 주석을 해제하세요.
# *.pt
# *.pth

# 임시 파일 및 로그 (Git에서 제외)
*.log
*.tmp
*.bak
temp/
.gemini/

# 분석 결과 캐시 (Git에서 제외)
data/**/cache/

# Quasar/Vue 빌드 파편 (Git에서 제외)
web-vue/.quasar/
web-vue/dist/
web-vue/node_modules/
web-vue/quasar.config.*.temporary.compiled*
